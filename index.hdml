      });
    };
    document.getElementById("btnHarvest").onclick = () => {
      window.InventoryState.slots.apples += 2;
      window.InventoryState.slots.wood += 2;
      alert("🍎 Harvested 2x Forest Apples & 2x Wood!");
    };
    let is5D = false;
    document.getElementById("btnShift").onclick = () => {
      is5D = !is5D;
      document.getElementById("dimVal").innerText = is5D ? "5D ETHEREAL" : "3D REALITY";
      document.getElementById("dimVal").style.color = is5D ? "#bf55ec" : "#00ffaa";
      terrainMat.color.setHex(is5D ? 0x2c003e : 0x1f3621);
    };
    // ==========================================
    // ১১. গেম ও অ্যানিমেশন লুপ (Eco-Lifecycle)
    // ==========================================
    const clock = new THREE.Clock();
    let dayCycle = 0;
    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.1);
      // সূর্য ও চাঁদের কক্ষপথ এবং আলোর পরিবর্তন
      dayCycle += dt * 0.04;
      const sunX = Math.cos(dayCycle) * 140;
      const sunY = Math.sin(dayCycle) * 140;
      sunLight.position.set(sunX, sunY, sunX * 0.5);
      sunMesh.position.set(sunX, sunY, sunX * 0.5);
      moonLight.position.set(-sunX, -sunY, -sunX * 0.5);
      moonMesh.position.set(-sunX, -sunY, -sunX * 0.5);
      const isNight = sunY < 0;
      document.getElementById("cycleTxt").innerText = isNight ? "NIGHT (COLD)" : "DAY";
      document.getElementById("cycleTxt").style.color = isNight ? "#3867d6" : "#ffd32a";
      ambientLight.intensity = isNight ? 0.15 : 0.45;
      // নদী প্রবাহ ও ঝর্ণা অ্যানিমেশন
      river.material.opacity = 0.78 + Math.sin(Date.now() * 0.003) * 0.05;
      waterfall.position.y = 3 + Math.sin(Date.now() * 0.008) * 0.15;
      // প্লেয়ার মুভমেন্ট ও লিম্ব অ্যানিমেশন
      if (joy.active) {
        player.position.x += joy.x * 12 * dt;
        player.position.z += joy.y * 12 * dt;
        player.rotation.y = Math.atan2(joy.x, joy.y);
        joy.walkTime += dt * 13;
        const swing = Math.sin(joy.walkTime) * 0.65;
        playerLimbs.leftLeg.rotation.x = swing;
        playerLimbs.rightLeg.rotation.x = -swing;
        playerLimbs.leftArm.rotation.x = -swing;
        playerLimbs.rightArm.rotation.x = swing;
        playerLimbs.chest.position.y = 1.6 + Math.abs(Math.sin(joy.walkTime * 2)) * 0.07;
      } else {
        playerLimbs.leftLeg.rotation.x = 0;
        playerLimbs.rightLeg.rotation.x = 0;
        playerLimbs.leftArm.rotation.x = 0;
        playerLimbs.rightArm.rotation.x = 0;
        playerLimbs.chest.position.y = 1.6;
      }
      // ক্যামেরা মসৃণ ট্র্যাকিং
      camera.position.x = player.position.x;
      camera.position.z = player.position.z + 13;
      camera.position.y = player.position.y + 6;
      camera.lookAt(player.position.x, player.position.y + 1.6, player.position.z);
      // বন্যপ্রাণী চলাচল (Wandering Animals)
      deerList.forEach((d, i) => { d.position.x += Math.sin(Date.now() * 0.001 + i) * 0.03; });
      pigList.forEach((p, i) => { p.position.z += Math.cos(Date.now() * 0.001 + i) * 0.025; });
      // জম্বি এআই (প্লেয়ারের দিকে তাড়া)
      zombieList.forEach(z => {
        if (z.hp > 0 && player.position.distanceTo(z.mesh.position) < 30) {
          z.mesh.lookAt(player.position.x, 0, player.position.z);
          z.mesh.translateZ(3.2 * dt);
        }
      });
      // বৃষ্টি কণা চলাচল
      if (isRaining) {
        const p = rainGeo.attributes.position.array;
        for (let i = 1; i < rainCount * 3; i += 3) {
          p[i] -= 45 * dt;
          if (p[i] < 0) p[i] = 60;
        }
        rainGeo.attributes.position.needsUpdate = true;
      }
      renderer.render(scene, camera);
    }
    animate();
    // ==========================================
    // ১২. ক্রাফটিং ও ইনভেন্টরি মোডাল নেভিগেশন
    // ==========================================
    document.getElementById("btnOpenCraft").onclick = () => { document.getElementById("craftingModal").style.display = "block"; };
    document.getElementById("btnCloseCraft").onclick = () => { document.getElementById("craftingModal").style.display = "none"; };
    document.getElementById("btnOpenInv").onclick = () => { document.getElementById("inventoryModal").style.display = "block"; };
    document.getElementById("btnCloseInv").onclick = () => { document.getElementById("inventoryModal").style.display = "none"; };
    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
