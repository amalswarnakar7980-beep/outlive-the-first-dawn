<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Outlive 5D - Autonomous Core</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
      touch-action: none;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #05070b;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
    }
    #gameContainer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
    }
    #sensoryFilter {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 99;
      transition: background 0.3s ease, filter 0.3s ease;
    }
    #hud {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 1000;
      background: rgba(10, 15, 26, 0.92);
      border: 1px solid #00ffaa;
      border-radius: 8px;
      padding: 8px 12px;
      color: #fff;
      font-size: 11px;
      backdrop-filter: blur(6px);
      box-shadow: 0 4px 15px rgba(0, 255, 170, 0.2);
    }
    .bar-bg {
      background: #1e293b;
      height: 4px;
      border-radius: 2px;
      margin: 3px 0 6px 0;
      width: 130px;
    }
    .bar-fill {
      height: 100%;
      border-radius: 2px;
      transition: width 0.2s;
    }
    #topNav {
      position: fixed;
      top: 12px;
      right: 12px;
      z-index: 1000;
      display: flex;
      gap: 8px;
    }
    .nav-btn {
      background: rgba(10, 18, 30, 0.85);
      border: 1px solid #00ffaa;
      border-radius: 6px;
      color: #00ffaa;
      font-weight: 800;
      font-size: 11px;
      padding: 8px 12px;
      cursor: pointer;
      backdrop-filter: blur(4px);
    }
    .nav-btn:active {
      transform: scale(0.96);
    }
    #joystickBase {
      position: fixed;
      bottom: 28px;
      left: 28px;
      width: 110px;
      height: 110px;
      background: rgba(15, 23, 42, 0.7);
      border: 2px solid #00ffaa;
      border-radius: 50%;
      z-index: 1000;
      box-shadow: 0 0 15px rgba(0, 255, 170, 0.25);
    }
    #joystickThumb {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 44px;
      height: 44px;
      margin-top: -22px;
      margin-left: -22px;
      background: #00ffaa;
      border-radius: 50%;
      box-shadow: 0 0 10px #00ffaa;
      pointer-events: none;
      transform: translate(0px, 0px);
    }
    #actionPad {
      position: fixed;
      bottom: 25px;
      right: 20px;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: flex-end;
    }
    .action-row {
      display: flex;
      gap: 10px;
    }
    .act-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.25);
      color: #fff;
      font-weight: 900;
      font-size: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0,0,0,0.6);
      touch-action: manipulation;
    }
    .act-btn:active {
      transform: scale(0.9);
    }
    #btnAttack {
      width: 62px;
      height: 62px;
      background: #d63031;
      border-color: #ff7675;
      font-size: 14px;
    }
    .game-modal {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 350px;
      max-width: 94vw;
      background: rgba(8, 14, 24, 0.96);
      border: 1px solid #00ffaa;
      border-radius: 12px;
      padding: 16px;
      color: #fff;
      z-index: 10005;
      box-shadow: 0 0 35px rgba(0, 255, 170, 0.3);
      backdrop-filter: blur(8px);
    }
    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 8px;
      margin-bottom: 10px;
    }
    .close-btn {
      background: none;
      border: none;
      color: #ff4757;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
    }
    .craft-tabs {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }
    .craft-tab-btn {
      flex: 1;
      padding: 6px 0;
      background: rgba(255,255,255,0.06);
      border: 1px solid #334155;
      color: #94a3b8;
      font-size: 10px;
      font-weight: bold;
      border-radius: 6px;
      cursor: pointer;
    }
    .craft-tab-btn.active {
      background: #00ffaa;
      color: #000;
      border-color: #00ffaa;
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

  <div id="gameContainer"></div>
  <div id="sensoryFilter"></div>

  <div id="hud">
    <div style="color: #00ffaa; font-weight: 800; margin-bottom: 4px;">OUTLIVE 5D CORE</div>
    <div>HP: <span id="hpVal">100</span>% | <span id="bpmVal" style="color: #2ed573;">72 BPM</span></div>
    <div class="bar-bg"><div id="hpBar" class="bar-fill" style="background: #ff4757; width: 100%;"></div></div>
    <div>STAMINA: <span id="nrgVal">100</span>%</div>
    <div class="bar-bg"><div id="nrgBar" class="bar-fill" style="background: #ffa502; width: 100%;"></div></div>
    <div>DIMENSION: <b id="dimVal" style="color: #00ffaa;">3D REALITY</b></div>
  </div>

  <div id="topNav">
    <button class="nav-btn" id="btnOpenCraft">CRAFT (C)</button>
    <button class="nav-btn" id="btnOpenInv">BACKPACK (I)</button>
  </div>

  <div id="joystickBase">
    <div id="joystickThumb"></div>
  </div>

  <div id="actionPad">
    <div class="action-row">
      <button class="act-btn" id="btnShift" style="background: #6c5ce7;">5D</button>
      <button class="act-btn" id="btnTime" style="background: #e17055;">TIME</button>
    </div>
    <div class="action-row">
      <button class="act-btn" id="btnCollect" style="background: #0984e3;">GET</button>
      <button class="act-btn" id="btnAttack">ATK</button>
    </div>
  </div>

  <div class="game-modal" id="craftingModal">
    <div class="modal-head">
      <span style="font-weight: 800; color: #00ffaa;">BLUEPRINT FABRICATOR</span>
      <button class="close-btn" id="btnCloseCraft">X</button>
    </div>
    <div class="craft-tabs">
      <button class="craft-tab-btn active" id="tabSurvival" onclick="switchCraftTab('survival')">SURVIVAL</button>
      <button class="craft-tab-btn" id="tabShelter" onclick="switchCraftTab('shelter')">SHELTER</button>
      <button class="craft-tab-btn" id="tabTech" onclick="switchCraftTab('tech')">5D TECH</button>
    </div>
    <div id="craftRecipeList" style="display: flex; flex-direction: column; gap: 8px; max-height: 230px; overflow-y: auto;"></div>
  </div>

  <div class="game-modal" id="inventoryModal">
    <div class="modal-head">
      <span style="font-weight: 800; color: #00ffaa;">NEURAL STORAGE</span>
      <button class="close-btn" id="btnCloseInv">X</button>
    </div>
    <div style="font-size: 11px; color: #848e9c; margin-bottom: 8px;">Load: <b id="invWeightText" style="color: #fff;">0.0</b> / 45.0 kg</div>
    <div id="invGrid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;"></div>
    <div id="itemDetailPane" style="background: rgba(255,255,255,0.05); padding: 8px; border-radius: 6px; font-size: 11px; min-height: 44px; margin-bottom: 8px;">
      <div id="selectedItemTitle" style="color: #00ffee; font-weight: bold;">Select an item</div>
      <div id="selectedItemDesc" style="color: #ccc; font-size: 10px;">Tap a slot to inspect or use.</div>
    </div>
    <button id="btnUseItem" style="width: 100%; background: #00ffaa; border: none; border-radius: 6px; padding: 8px; font-weight: bold; cursor: pointer; color: #000;">USE ITEM</button>
  </div>

  <script>
    // ১. গ্লোবাল স্টেট ইনিশিয়ালাইজেশন
    window.InventoryState = {
      slots: { wood: 10, stone: 8, fabric: 4, raw_food: 2, quantum_core: 1 },
      deployables: { campfire: 0, water_collector: 0, tent: 0, barricade: 0, temporal_beacon: 0 }
    };

    window.masterScene = new THREE.Scene();
    window.masterCamera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    window.masterCamera.position.set(0, 6, 12);

    window.masterRenderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    window.masterRenderer.setSize(window.innerWidth, window.innerHeight);
    window.masterRenderer.shadowMap.enabled = true;
    document.getElementById("gameContainer").appendChild(window.masterRenderer.domElement);

    // ২. আকাশ, সূর্য, চাঁদ ও পরিবেশ সোর্স
    window.worldSources = {
      skyFog: new THREE.FogExp2(0x06090e, 0.012),
      ambientLight: new THREE.AmbientLight(0xffffff, 0.8),
      sunLight: new THREE.DirectionalLight(0xffffff, 1.4),
      moonLight: new THREE.DirectionalLight(0x3867d6, 0.4),
      sunMesh: new THREE.Mesh(new THREE.SphereGeometry(3, 16, 16), new THREE.MeshBasicMaterial({ color: 0xffa502 })),
      moonMesh: new THREE.Mesh(new THREE.SphereGeometry(2.5, 16, 16), new THREE.MeshBasicMaterial({ color: 0xdff9fb })),
      terrainGrid: new THREE.GridHelper(240, 60, 0x00ffaa, 0x1f293d)
    };

    window.worldSources.sunLight.position.set(20, 40, 20);
    window.worldSources.sunLight.castShadow = true;
    window.worldSources.moonLight.position.set(-20, -40, -20);
    window.worldSources.sunMesh.position.set(20, 40, 20);
    window.worldSources.moonMesh.position.set(-20, -40, -20);

    window.masterScene.fog = window.worldSources.skyFog;
    window.masterScene.add(window.worldSources.ambientLight);
    window.masterScene.add(window.worldSources.sunLight);
    window.masterScene.add(window.worldSources.moonLight);
    window.masterScene.add(window.worldSources.sunMesh);
    window.masterScene.add(window.worldSources.moonMesh);
    window.masterScene.add(window.worldSources.terrainGrid);

    // ভিজ্যুয়াল গ্রাউন্ড ফ্লোর
    const floorGeo = new THREE.PlaneGeometry(240, 240);
    floorGeo.rotateX(-Math.PI / 2);
    const floorMat = new THREE.MeshStandardMaterial({ color: 0x0a101d, roughness: 0.8 });
    const floorMesh = new THREE.Mesh(floorGeo, floorMat);
    floorMesh.receiveShadow = true;
    window.masterScene.add(floorMesh);

    // ৩. সম্পূর্ণ দৃশ্যমান হিউম্যানয়েড অবতার
    window.humanoidPlayer = new THREE.Group();

    const skinMat = new THREE.MeshStandardMaterial({ color: 0x00ffaa, roughness: 0.3, metalness: 0.2 });
    const limbMat = new THREE.MeshStandardMaterial({ color: 0x0abde3, roughness: 0.4 });
    const jointMat = new THREE.MeshStandardMaterial({ color: 0xffffff });

    const torso = new THREE.Mesh(new THREE.BoxGeometry(1.0, 1.4, 0.6), skinMat);
    torso.position.y = 1.4;
    torso.castShadow = true;
    window.humanoidPlayer.add(torso);

    const head = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.6, 0.6), limbMat);
    head.position.y = 2.45;
    head.castShadow = true;
    window.humanoidPlayer.add(head);

    const visor = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.2, 0.2), jointMat);
    visor.position.set(0, 2.45, 0.3);
    window.humanoidPlayer.add(visor);

    const leftArm = new THREE.Mesh(new THREE.BoxGeometry(0.3, 1.1, 0.3), limbMat);
    leftArm.position.set(-0.7, 1.4, 0);
    const rightArm = new THREE.Mesh(new THREE.BoxGeometry(0.3, 1.1, 0.3), limbMat);
    rightArm.position.set(0.7, 1.4, 0);
    window.humanoidPlayer.add(leftArm);
    window.humanoidPlayer.add(rightArm);

    const leftLeg = new THREE.Mesh(new THREE.BoxGeometry(0.35, 1.2, 0.35), limbMat);
    leftLeg.position.set(-0.3, 0.6, 0);
    const rightLeg = new THREE.Mesh(new THREE.BoxGeometry(0.35, 1.2, 0.35), limbMat);
    rightLeg.position.set(0.3, 0.6, 0);
    window.humanoidPlayer.add(leftLeg);
    window.humanoidPlayer.add(rightLeg);

    window.humanoidLimbs = { torso, head, leftArm, rightArm, leftLeg, rightLeg };
    window.humanoidPlayer.position.set(0, 0, 0);
    window.masterScene.add(window.humanoidPlayer);
    window.masterCamera.lookAt(0, 1.2, 0);

    // ৪. ফুলপ্রুফ বিল্ট-ইন অ্যানালগ জয়স্টিক ও ডাইরেক্ট কাইনেমেটিক্স
    const joyController = {
      x: 0,
      y: 0,
      active: false,
      walkTime: 0,
      speed: 11.0,

      init() {
        const base = document.getElementById("joystickBase");
        const thumb = document.getElementById("joystickThumb");
        if (!base || !thumb) return;

        let touchId = null;
        let center = { x: 0, y: 0 };
        const maxRadius = 38;

        base.addEventListener("touchstart", (e) => {
          e.preventDefault();
          const t = e.changedTouches[0];
          touchId = t.identifier;
          const rect = base.getBoundingClientRect();
          center = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        }, { passive: false });

        window.addEventListener("touchmove", (e) => {
          if (touchId === null) return;
          for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (t.identifier === touchId) {
              let dx = t.clientX - center.x;
              let dy = t.clientY - center.y;
              const dist = Math.hypot(dx, dy);

              if (dist > maxRadius) {
                dx = (dx / dist) * maxRadius;
                dy = (dy / dist) * maxRadius;
              }

              thumb.style.transform = `translate(${dx}px, ${dy}px)`;
              this.x = dx / maxRadius;
              this.y = dy / maxRadius;
              this.active = Math.abs(dx) > 3 || Math.abs(dy) > 3;
              break;
            }
          }
        }, { passive: false });

        const reset = () => {
          touchId = null;
          thumb.style.transform = `translate(0px, 0px)`;
          this.x = 0;
          this.y = 0;
          this.active = false;
        };

        window.addEventListener("touchend", reset);
        window.addEventListener("touchcancel", reset);
      }
    };
    joyController.init();

    // ৫. স্ট্যান্ডঅ্যালোন ফ্রেম লুপ
    const internalClock = new THREE.Clock();

    function masterEngineLoop() {
      requestAnimationFrame(masterEngineLoop);

      const delta = Math.min(internalClock.getDelta(), 0.1);
      const player = window.humanoidPlayer;
      const limbs = window.humanoidLimbs;
      const cam = window.masterCamera;

      if (player && limbs) {
        if (joyController.active) {
          const mx = joyController.x;
          const mz = joyController.y;

          player.position.x += mx * joyController.speed * delta;
          player.position.z += mz * joyController.speed * delta;
          player.rotation.y = Math.atan2(mx, mz);

          joyController.walkTime += delta * 12;
          const swing = Math.sin(joyController.walkTime) * 0.7;

          limbs.leftLeg.rotation.x = swing;
          limbs.rightLeg.rotation.x = -swing;
          limbs.leftArm.rotation.x = -swing;
          limbs.rightArm.rotation.x = swing;
          limbs.torso.position.y = 1.4 + Math.abs(Math.sin(joyController.walkTime * 2)) * 0.08;
        } else {
          limbs.leftLeg.rotation.x = 0;
          limbs.rightLeg.rotation.x = 0;
          limbs.leftArm.rotation.x = 0;
          limbs.rightArm.rotation.x = 0;
          limbs.torso.position.y = 1.4;
        }

        // ক্যামেরা ট্র্যাকিং
        if (cam) {
          cam.position.x = player.position.x;
          cam.position.z = player.position.z + 12;
          cam.position.y = player.position.y + 6;
          cam.lookAt(player.position.x, player.position.y + 1.2, player.position.z);
        }
      }

      // এক্সটার্নাল ওয়ার্ল্ড ইফেক্ট থাকলে কল করা
      if (typeof window.updateWorld5D === "function") {
        window.updateWorld5D(delta);
      }

      window.masterRenderer.render(window.masterScene, window.masterCamera);
    }
    masterEngineLoop();

    // ৬. ক্রাফটিং ও ইউআই লজিক
    window.MasterCraftingData = {
      survival: {
        campfire: { name: "Thermic Campfire", cost: { wood: 4, stone: 2 } },
        water_collector: { name: "Water Condenser", cost: { wood: 3, fabric: 2 } }
      },
      shelter: {
        tent: { name: "Reinforced Tent", cost: { wood: 6, fabric: 4 } },
        barricade: { name: "Wood Barricade", cost: { wood: 8 } }
      },
      tech: {
        temporal_beacon: { name: "5D Anchor Beacon", cost: { stone: 5, quantum_core: 1 } }
      }
    };

    let activeCraftTab = "survival";
    function switchCraftTab(tab) {
      activeCraftTab = tab;
      document.querySelectorAll(".craft-tab-btn").forEach(b => {
        b.classList.toggle("active", b.id.toLowerCase().includes(tab));
      });
      renderCraftUI();
    }

    function renderCraftUI() {
      const list = document.getElementById("craftRecipeList");
      if (!list) return;
      list.innerHTML = "";

      const recipes = window.MasterCraftingData[activeCraftTab] || {};
      Object.keys(recipes).forEach(key => {
        const item = recipes[key];
        let canAfford = true;
        let costTxt = Object.keys(item.cost).map(m => {
          const has = (window.InventoryState && window.InventoryState.slots[m]) || 0;
          if (has < item.cost[m]) canAfford = false;
          return `${m}: ${has}/${item.cost[m]}`;
        }).join(" | ");

        const row = document.createElement("div");
        row.style.cssText = `background: rgba(20,30,45,0.85); border: 1px solid ${canAfford ? "#00ffaa" : "#334155"}; border-radius: 8px; padding: 8px; display: flex; justify-content: space-between; align-items: center;`;
        row.innerHTML = `
          <div>
            <div style="font-weight: 700; font-size: 11px;">${item.name}</div>
            <div style="font-size: 9px; color: ${canAfford ? "#2ed573" : "#ff4757"}; font-weight: bold; margin-top: 2px;">${costTxt}</div>
          </div>
          <button style="background: ${canAfford ? "#00b894" : "#475569"}; border: none; border-radius: 6px; color: #fff; font-weight: bold; font-size: 10px; padding: 6px 10px; cursor: ${canAfford ? "pointer" : "not-allowed"};" ${canAfford ? "" : "disabled"}>DEPLOY</button>
        `;

        if (canAfford) {
          row.querySelector("button").onclick = () => {
            for (let m in item.cost) {
              window.InventoryState.slots[m] -= item.cost[m];
            }
            const geo = (key === "tent") ? new THREE.ConeGeometry(2, 2.5, 4) : new THREE.CylinderGeometry(0.8, 1.1, 0.4, 8);
            const mat = new THREE.MeshStandardMaterial({ color: key === "tent" ? 0x16a085 : 0xd35400, roughness: 0.7 });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(window.humanoidPlayer.position.x + 2, 0.5, window.humanoidPlayer.position.z + 2);
            window.masterScene.add(mesh);
            renderCraftUI();
          };
        }
        list.appendChild(row);
      });
    }

    // বাটন হ্যান্ডলারস
    document.getElementById("btnOpenCraft").onclick = () => {
      document.getElementById("craftingModal").style.display = "block";
      document.getElementById("inventoryModal").style.display = "none";
      renderCraftUI();
    };
    document.getElementById("btnCloseCraft").onclick = () => document.getElementById("craftingModal").style.display = "none";

    document.getElementById("btnOpenInv").onclick = () => {
      document.getElementById("inventoryModal").style.display = "block";
      document.getElementById("craftingModal").style.display = "none";
      renderInventoryGrid();
    };
    document.getElementById("btnCloseInv").onclick = () => document.getElementById("inventoryModal").style.display = "none";

    function renderInventoryGrid() {
      const grid = document.getElementById("invGrid");
      if (!grid) return;
      grid.innerHTML = "";
      Object.keys(window.InventoryState.slots).forEach(key => {
        const count = window.InventoryState.slots[key];
        const slot = document.createElement("div");
        slot.style.cssText = `background: rgba(255,255,255,0.06); border: 1px solid #333; border-radius: 6px; padding: 6px 0; text-align: center;`;
        slot.innerHTML = `<div style="font-size: 10px; font-weight: bold;">${key.toUpperCase()}</div><div style="font-size: 11px; color: #00ffaa;">${count}</div>`;
        grid.appendChild(slot);
      });
    }

    document.getElementById("btnAttack").onclick = () => {
      if (window.humanoidLimbs) {
        window.humanoidLimbs.rightArm.rotation.x = -Math.PI / 2;
        setTimeout(() => {
          if (window.humanoidLimbs) window.humanoidLimbs.rightArm.rotation.x = 0;
        }, 180);
      }
    };

    document.getElementById("btnCollect").onclick = () => {
      window.InventoryState.slots.wood += 2;
      window.InventoryState.slots.stone += 1;
      alert("+2 Wood, +1 Stone Added!");
    };

    document.getElementById("btnShift").onclick = () => {
      if (typeof window.setDimension5D === "function") {
        window.setDimension5D(window.is5D ? 0.0 : 1.0);
        window.is5D = !window.is5D;
      } else {
        window.is5D = !window.is5D;
        document.getElementById("dimVal").innerText = window.is5D ? "5D ETHEREAL" : "3D REALITY";
        document.getElementById("dimVal").style.color = window.is5D ? "#bf55ec" : "#00ffaa";
      }
    };

    window.addEventListener("resize", () => {
      if (window.masterCamera && window.masterRenderer) {
        window.masterCamera.aspect = window.innerWidth / window.innerHeight;
        window.masterCamera.updateProjectionMatrix();
        window.masterRenderer.setSize(window.innerWidth, window.innerHeight);
      }
    });
  </script>

